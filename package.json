{
  "name": "executive-office-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "PREVIEW_MODE=true tsx server.ts",
    "dev:local": "tsx server.ts",
    "server": "tsx server.ts",
    "start": "NODE_ENV=production tsx server.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/backup.ts --verify",
    "backup:restore-test": "tsx scripts/backup.ts --restore-test",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "better-sqlite3": "13.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "express": "4.21.2",
    "helmet": "8.3.0",
    "lucide-react": "0.546.0",
    "motion": "12.23.24",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.21",
    "@types/node": "22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "autoprefixer": "10.4.21",
    "ignore": "7.0.12",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.3"
  }
}
