# Server & Runtime Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_64_CHAR_SECRET"

# Database & Runtime Paths (isolated from source directories)
DATA_DIR="./var/data"
BACKUP_DIR="./var/backups"

# Encrypted Backup Configuration (AES-256-GCM with scrypt key derivation)
# Passphrase must be kept strictly offline in a sealed location.
BACKUP_PASSPHRASE="REPLACE_WITH_STRONG_OFFLINE_PASSPHRASE"
BACKUP_RETENTION=7
BACKUP_ALLOW_PLAINTEXT=false

