# ==============================================================================
# بوابة مكتب رئيس مجلس الإدارة — الهيئة القومية للبريد المصري
# ملف تهيئة متغيرات البيئة للتشغيل المحلي المعزول (Production & Air-Gapped Environment)
# ==============================================================================

# 1. إعدادات الشبكة ومنفذ الخادم (الافتراضي: 3000)
PORT=3000

# 2. بيئة تشغيل الخادم (production للإنتاج / development للتطوير / test للاختبارات)
NODE_ENV=production

# 3. المسار المحلي لتخزين قاعدة بيانات SQLite وملفات النظام
DATA_DIR="./var/data"

# 4. المسار المحلي لحفظ النسخ الاحتياطية المشفرة
BACKUP_DIR="./var/backups"

# 5. عدد النسخ الاحتياطية المحتفظ بها قبل تدوير وحذف النسخ القديمة (الافتراضي: 7)
BACKUP_RETENTION=7

# 6. كلمة مرور تشفير النسخ الاحتياطية العسكرية (AES-256-GCM مع اشتقاق scrypt)
BACKUP_PASSPHRASE=""

# 7. مسار ملف نصي محمي يحتوي على كلمة مرور النسخ الاحتياطي (أذونات 0600 - بديل آمن لمتغير البيئة)
BACKUP_PASSPHRASE_FILE=""

# 8. السماح الاستثنائي بإنشاء نسخ احتياطية غير مشفرة (false افتراضياً للحماية الصارمة)
BACKUP_ALLOW_PLAINTEXT=false

# 9. فرض تشفير ملفات تعريف الارتباط عبر HTTPS (true افتراضياً في الإنتاج)
COOKIE_SECURE=true

# 10. إعدادات الوكيل العكسي الموثوق Nginx / Reverse Proxy (false أو عدد القفزات)
TRUST_PROXY=false

# 11. النطاقات المسموح لها بالاتصال عبر CORS و Origin (مفصولة بفواصل، فارغ للاتصال المحلي)
ALLOWED_ORIGINS=""

# 12. مهلة خمول جلسة العمل بالدقائق قبل القفل التلقائي للشاشة (الافتراضي: 30 دقيقة)
SESSION_IDLE_MINUTES=30

# 13. الحد الأقصى المطلق لصلاحية جلسة العمل بالساعات قبل إنهاء الجلسة (الافتراضي: 12 ساعة)
SESSION_ABSOLUTE_HOURS=12

# 14. تفعيل نمط المعاينة في بيئة التطوير لتجاوز قيود التضمين (false في الإنتاج)
PREVIEW_MODE=false

# 15. قائمة النطاقات المسموح لها بتضمين الصفحة في نمط المعاينة فقط (مفصولة بمسافات)
FRAME_ANCESTORS="'self' https://aistudio.google.com"
